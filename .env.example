# WebMCP Guard — environment template.
# Copy to `.env.local` in the app that needs it (never commit real values).

# HMAC key used to derive deterministic tokens (tok_<class>_<hex8>).
# Changing it invalidates every existing token. Server-side only.
GUARD_ORG_SECRET=dev-org-secret-change-me

# AES-256-GCM key for the token vault (token -> encrypted value).
# 32 bytes, base64 or hex. Server-side only; never sent to the browser.
GUARD_VAULT_KEY=dev-vault-key-change-me

# Bearer token that guards the admin API (/policies, /logs, /stats,
# /tokens/reveal) and is entered once on the console login screen.
GUARD_ADMIN_TOKEN=dev-admin-token-change-me

# Origin allowed to call the portal's admin API cross-origin (the console).
# Example in production: https://webmcp-guard-console.vercel.app
GUARD_CONSOLE_ORIGIN=http://localhost:3001

# Console-side: base URL of the portal's mounted WebMCP Guard API.
# Public by definition (baked into the browser bundle) — no secrets here.
# Read at build time by apps/console; unset, the console falls back to this
# same localhost value, so `pnpm dev` needs no console env at all. In
# production point it at the deployed portal and set GUARD_CONSOLE_ORIGIN
# there to match the console's origin, or every request fails CORS.
NEXT_PUBLIC_GUARD_API_URL=http://localhost:3000/api/guard

# Portal-side: where the demo SQLite file lives. Defaults to
# `apps/portal/data/portal.db` (created and seeded on boot if missing).
# Point it at a mounted disk in production, or `:memory:` in tests.
# PORTAL_DB_PATH=

# Optional (Phase 5 stretch): API key for the LLM justification evaluator.
# Any OpenAI-compatible chat endpoint. Unset => heuristic evaluator only.
# LLM_API_KEY=
